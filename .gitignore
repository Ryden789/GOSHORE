# 敏感信息与本地数据（goshor.db 含个人作答记录且体积大，settings.json 含密钥，不分发）
data/settings.json
data/import_state.json
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# 迁移工具留下的老库退路（goshor.db.migrated，动辄 400 MB+），绝不可入库
data/*.db.migrated
data/*.db.bak
data/.split-migrate-*/
# 桌面模式（desktop.py）的 WebView2 用户数据：localStorage / 缓存，随程序生成，不分发
data/webview/

# Python
__pycache__/
*.pyc
.venv/

# 测试/临时文件
data/test*.pdf
scripts/_*.py
scripts/_*_tmp/
.tmp/
# 宣传材料导出产物（PDF / 逐页 PNG，可由 docs/05-宣传/*.md 重新生成，不分发）
/output/
/tmp/

# 安卓构建工具链与产物
.tools/
.android-sdk/
dist/
.vscode/
android/local.properties
android/.gradle/
android/build/
android/app/build/

# Trae IDE 工作目录（日志、wheels、临时文档等，不分发）
.trae/

# WorkBuddy AI 本地工作目录（记忆、技能等，仅本机）
.workbuddy-ai/
.workbuddy/
