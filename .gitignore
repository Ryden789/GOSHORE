# 敏感信息与本地数据（goshor.db 含个人作答记录且体积大，settings.json 含密钥，不分发）
data/settings.json
data/import_state.json
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# 迁移工具留下的老库退路（goshor.db.migrated，动辄 400 MB+），绝不可入库
data/*.db.migrated
data/*.db.bak
data/.split-migrate-*/
# 桌面模式（desktop.py）的 WebView2 用户数据：localStorage / 缓存，随程序生成，不分发
data/webview/
# 运行日志（app.log + 轮转的 app.log.1~3）：本机运行产物，可能含题库路径
data/logs/

# Python
__pycache__/
*.pyc
.venv/

# 测试/临时文件
data/test*.pdf
scripts/_*.py
scripts/_*_tmp/
.tmp/
# 一次性冒烟脚本的截图产物（scripts/_smoke_weak_ui.py）
.smoke/
# pytest 的临时目录与缓存（DSH 沙箱下可能残留、普通权限删不掉）
.pytest_tmp*/
.pytest_cache/
# 覆盖率产物（pytest --cov 生成，每次跑都变）
.coverage
.coverage.*
htmlcov/
# 测试/脚本遗留的根目录临时目录
/tmp*/
# 本地讲义与 PDF 提取中间产物（源文件约 2 GB，可按 scripts/pdf_notes_extract*.py 重建）
/知识点综合/
# 题库抽检单（可能含题目原文，按需本地留存，不入库）
/reports/
# 宣传材料导出产物（PDF / 逐页 PNG，可由 docs/05-宣传/*.md 重新生成，不分发）
/output/
/tmp/

# 安卓构建工具链与产物
.tools/
.android-sdk/
dist/
.vscode/
android/local.properties
android/.gradle/
android/build/
android/app/build/

# Trae IDE 工作目录（日志、wheels、临时文档等，不分发）
.trae/

# WorkBuddy AI 本地工作目录（记忆、技能等，仅本机）
.workbuddy-ai/
.workbuddy/

# GPL 项目的阅读笔记（只放 .md/.txt，不存放其源码；见 docs/来源与许可登记.md）
/reference_only/
# 对账报告（本机生成，含本机题库统计；数字转录进 docs，不入库）
data/import_report.json
